---
import { productFamilies } from '../data/productLines';

const services = [
  { label: 'Capacitación', href: '/capacitacion' },
  { label: 'PostVenta', href: '/postventa' }
];

const contactLinks = [
  { label: 'ventas@etapel.com.mx', href: 'mailto:ventas@etapel.com.mx' },
  { label: '55 5689 5055', href: 'tel:+525556895055' },
  { label: 'WhatsApp', href: 'https://wa.link/oowyzu' }
];

const footerKeywords = [
  'pintura automotriz CDMX',
  'taller automotriz CDMX',
  'equipo para taller CDMX',
  'cabina de pintura CDMX',
  'pistola de pintura CDMX',
  'consumibles de pintura CDMX',
  'soldadura automotriz CDMX',
  'aire comprimido CDMX',
  'capacitación automotriz CDMX',
  'postventa automotriz CDMX',
  'mantenimiento de equipos CDMX',
  'soporte técnico CDMX',
  'tecnología para taller CDMX',
  'soluciones para carrocería CDMX',
  'servicio técnico especializado CDMX',
  'centro de capacitación CDMX',
  'soluciones certificadas CDMX',
  'cotización de equipos automotrices CDMX'
];
---

<footer class="border-t border-slate-300/80 bg-[#d6e1ea] pb-8 pt-14 text-slate-900">
  <div class="shell">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.95fr_0.8fr_0.9fr]">
      <div>
        <img src="/images/logo-etapel.webp" alt="Etapel" class="h-12 w-auto" loading="lazy" />
        <p class="mt-6 max-w-md text-base leading-8 text-slate-800">
          En Etapel, no somos solo proveedores, somos socios en el crecimiento de tu negocio.
        </p>
        <p class="mt-4 max-w-md text-sm leading-7 text-slate-700">
          Descubre cómo podemos ayudarte a alcanzar nuevos niveles de éxito.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Línea de producto</h3>
        <ul class="mt-5 space-y-3">
          {
            productFamilies.map((family) => (
              <li>
                <a href={family.href} class="text-sm text-slate-800 transition hover:text-sky-700">
                  {family.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Servicios</h3>
        <ul class="mt-5 space-y-3">
          {
            services.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-slate-800 transition hover:text-sky-700">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Contacto</h3>
        <ul class="mt-5 space-y-3">
          {
            contactLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-slate-800 transition hover:text-sky-700"
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-slate-300/80 pt-6 text-sm text-slate-700 sm:flex-row sm:items-center sm:justify-between">
      <p>Copyright © 2026 Etapel. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <a href="/contacto" class="transition hover:text-sky-700">¿Necesitas ayuda? ¡Contáctanos!</a>
        <a href="/aviso-de-privacidad" class="transition hover:text-sky-700">Aviso de Privacidad</a>
        <a href="/en" class="transition hover:text-sky-700">English version</a>
      </div>
    </div>

    <div class="mt-4 border-t border-slate-300/70 pt-4">
      <p class="text-center text-[11px] leading-6 text-slate-600">
        {footerKeywords.join(' · ')}
      </p>
    </div>
  </div>
</footer>
