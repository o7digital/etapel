---
import { productFamilies } from '../data/productLines';

const navItems = [
  { label: 'Home', href: '/' },
  { label: '¿Quiénes Somos?', href: '/#quienes-somos' },
  { label: 'Capacitación', href: '/capacitacion' },
  { label: 'PostVenta', href: '/postventa' },
  { label: 'Contacto', href: '/contacto' }
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="shell pt-4">
    <div class="rounded-full border border-white/10 bg-[#061018]/80 px-4 py-3 shadow-[0_22px_70px_rgba(0,0,0,0.38)] backdrop-blur-xl">
      <div class="flex items-center justify-between gap-4">
        <a href="/" class="shrink-0 transition-opacity hover:opacity-80" aria-label="Ir al inicio">
          <img
            src="/images/logo-etapel-white.webp"
            alt="Etapel"
            class="h-10 w-auto sm:h-11"
            loading="eager"
          />
        </a>

        <nav class="hidden lg:block" aria-label="Navegación principal">
          <ul class="flex items-center gap-6 text-sm font-semibold text-slate-100">
            <li>
              <a
                href="/"
                class="relative py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 hover:after:scale-x-100"
              >
                Home
              </a>
            </li>

            <li class="group relative">
              <a
                href="/linea-de-producto"
                class="relative inline-flex items-center gap-2 py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 group-hover:after:scale-x-100 hover:after:scale-x-100"
              >
                Línea de Producto
                <svg class="h-4 w-4 transition duration-300 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.513a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
                </svg>
              </a>

              <div class="pointer-events-none absolute left-1/2 top-full z-50 w-[min(1100px,calc(100vw-3rem))] -translate-x-1/2 px-4 pt-5 opacity-0 transition duration-200 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
                <div class="grid gap-6 rounded-[30px] border border-slate-200 bg-white p-6 text-slate-900 shadow-[0_28px_80px_rgba(15,23,42,0.16)] xl:grid-cols-[1.4fr_0.6fr]">
                  <div>
                    <div class="mb-6">
                      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-700">Línea de Producto</p>
                      <h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-950">Cuatro familias principales</h3>
                      <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-500">
                        Una navegación simple para encontrar la categoría adecuada sin convertir el menú en catálogo.
                      </p>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                      {
                        productFamilies.map((family) => (
                          <a
                            href={family.href}
                            class="group rounded-[24px] border border-slate-200 bg-slate-50 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-sky-200 hover:bg-sky-50"
                          >
                            <p class="text-base font-bold tracking-[-0.02em] text-slate-950">{family.title}</p>
                            <p class="mt-2 text-sm leading-7 text-slate-600">{family.menuDescription}</p>
                            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition duration-300 group-hover:text-sky-700">
                              Ver categoría
                              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.22 4.97a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06L11.19 10 7.22 6.03a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                              </svg>
                            </span>
                          </a>
                        ))
                      }
                    </div>
                  </div>

                  <div class="rounded-[24px] border border-slate-200 bg-[linear-gradient(180deg,#f7fbff,#edf5fb)] p-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-700">Acceso rápido</p>
                    <h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-950">Navegación ligera</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-600">
                      Explora las cuatro familias o entra al hub general para orientarte mejor.
                    </p>
                    <div class="mt-6 grid gap-3">
                      <a href="/linea-de-producto" class="btn-outline justify-center">Ver todas las líneas</a>
                      <a href="/contacto" class="btn-primary justify-center">Hablar con un asesor</a>
                    </div>
                  </div>
                </div>
              </div>
            </li>

            {
              navItems.slice(1).map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="relative py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 hover:after:scale-x-100"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/contacto"
            class="hidden rounded-full border border-cyan-300/30 bg-cyan-300/10 px-5 py-3 text-sm font-semibold text-cyan-100 transition duration-300 hover:-translate-y-0.5 hover:bg-cyan-300/20 sm:inline-flex"
          >
            Solicitar información
          </a>

          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/12 bg-white/5 text-white transition hover:bg-white/10 lg:hidden"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menú"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden pt-4 lg:hidden" data-menu-panel>
        <nav aria-label="Navegación móvil">
          <ul class="grid gap-2 rounded-[24px] border border-white/10 bg-white/5 p-3 text-sm font-semibold text-slate-100">
            <li>
              <a href="/" class="block rounded-2xl px-4 py-3 transition hover:bg-white/10">Home</a>
            </li>

            <li>
              <details class="rounded-2xl border border-white/10 bg-white/5 p-1">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-2xl px-4 py-3">
                  <span>Línea de Producto</span>
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.513a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
                  </svg>
                </summary>
                <div class="grid gap-2 px-3 pb-3 pt-2 text-sm">
                  <a href="/linea-de-producto" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-cyan-100">
                    Ver todas las líneas de producto
                  </a>
                  {
                    productFamilies.map((family) => (
                      <a href={family.href} class="rounded-2xl px-4 py-3 text-slate-200 transition hover:bg-white/10">
                        <span class="block font-semibold">{family.title}</span>
                        <span class="mt-1 block text-xs leading-6 text-slate-400">{family.menuDescription}</span>
                      </a>
                    ))
                  }
                  <a href="/contacto" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-slate-200 transition hover:bg-white/10">
                    Hablar con un asesor
                  </a>
                </div>
              </details>
            </li>

            {
              navItems.slice(1).map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-2xl px-4 py-3 transition hover:bg-white/10"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/contacto"
                class="mt-2 inline-flex w-full justify-center rounded-full border border-cyan-300/30 bg-cyan-300/10 px-5 py-3 text-sm font-semibold text-cyan-100 transition duration-300 hover:bg-cyan-300/20"
              >
                Solicitar información
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');

  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      panel.classList.toggle('hidden', isOpen);
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.classList.add('hidden');
      });
    });
  }
</script>
