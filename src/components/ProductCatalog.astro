---
import { catalogProducts, productDetailPath } from '../data/products';
import { productFamilies } from '../data/productLines';

interface Props {
  familySlug?: string;
}

const { familySlug } = Astro.props as Props;
const initialProducts = familySlug
  ? catalogProducts.filter((product) => product.familySlug === familySlug)
  : catalogProducts;
const activeFamily = familySlug ? productFamilies.find((family) => family.slug === familySlug) : undefined;
const familyOptions = productFamilies.filter((family) =>
  catalogProducts.some((product) => product.familySlug === family.slug)
);
const categories = Array.from(new Set(initialProducts.map((product) => product.category))).sort();
const technologies = Array.from(new Set(initialProducts.map((product) => product.technology))).sort();
const brands = Array.from(new Set(initialProducts.map((product) => product.brand))).sort();
---

<section id="catalogo-productos" class="bg-[#f6f9fc] py-16 sm:py-20">
  <div class="shell">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <span class="section-kicker text-slate-700">Catálogo de productos</span>
        <h2 class="section-title mt-4 text-slate-950">
          {activeFamily ? `Explorar productos de ${activeFamily.shortTitle}` : 'Explorar productos por marca, línea y aplicación'}
        </h2>
        <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
          Busca, filtra y abre fichas de detalle para revisar aplicaciones, variantes, datos clave y solicitar información comercial.
        </p>
      </div>

      <div class="grid gap-3 rounded-[8px] border border-slate-200 bg-white p-4 shadow-[0_18px_50px_rgba(15,23,42,0.06)] sm:grid-cols-3">
        <div>
          <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">{initialProducts.length}</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Productos</p>
        </div>
        <div>
          <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">{brands.length}</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Marcas</p>
        </div>
        <div>
          <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">{categories.length}</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Categorías</p>
        </div>
      </div>
    </div>

    <div class="mt-8 rounded-[8px] border border-slate-200 bg-white p-4 shadow-[0_18px_50px_rgba(15,23,42,0.05)]" data-product-catalog>
      <div class="grid gap-3 lg:grid-cols-[1.15fr_0.8fr_0.8fr_0.8fr_0.7fr]">
        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Buscar producto</span>
          <input
            type="search"
            data-catalog-search
            class="field-input rounded-[8px]"
            placeholder="Buscar por SATA, pistola, RPS, filtro..."
          />
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Marca</span>
          <select data-catalog-brand class="field-select rounded-[8px]">
            <option value="">Todas</option>
            {brands.map((brand) => <option value={brand}>{brand}</option>)}
          </select>
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Categoría</span>
          <select data-catalog-category class="field-select rounded-[8px]">
            <option value="">Todas</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Tecnología</span>
          <select data-catalog-technology class="field-select rounded-[8px]">
            <option value="">Todas</option>
            {technologies.map((technology) => <option value={technology}>{technology}</option>)}
          </select>
        </label>

        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Orden</span>
          <select data-catalog-sort class="field-select rounded-[8px]">
            <option value="name">Nombre</option>
            <option value="category">Categoría</option>
            <option value="brand">Marca</option>
          </select>
        </label>
      </div>

      {
        !activeFamily && (
          <div class="mt-4 flex flex-wrap gap-2" aria-label="Filtros por línea de producto">
            <button type="button" data-catalog-family value="" class="rounded-full border border-sky-700 bg-sky-700 px-4 py-2 text-sm font-semibold text-white">
              Todas las líneas
            </button>
            {familyOptions.map((family) => (
              <button type="button" data-catalog-family value={family.slug} class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700">
                {family.shortTitle}
              </button>
            ))}
          </div>
        )
      }

      <div class="mt-5 flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm font-semibold text-slate-700">
          <span data-catalog-count>{initialProducts.length}</span> producto(s) encontrados
        </p>
        <button type="button" data-catalog-reset class="w-fit rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700">
          Limpiar filtros
        </button>
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-2 xl:grid-cols-3" data-catalog-grid>
        {
          initialProducts.map((product) => (
            <article
              class="group flex min-h-[430px] flex-col overflow-hidden rounded-[8px] border border-slate-200 bg-white shadow-[0_14px_38px_rgba(15,23,42,0.05)] transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_22px_60px_rgba(14,116,144,0.10)]"
              data-catalog-card
              data-name={product.name.toLowerCase()}
              data-brand={product.brand}
              data-family={product.familySlug}
              data-category={product.category}
              data-technology={product.technology}
              data-search={`${product.name} ${product.brand} ${product.category} ${product.technology} ${product.application} ${product.summary} ${product.badges.join(' ')}`.toLowerCase()}
            >
              <a href={productDetailPath(product)} class="flex h-full flex-col">
                <div class="flex h-56 items-center justify-center bg-slate-50 p-6">
                  <img src={product.image} alt={product.name} class="max-h-full w-full object-contain transition duration-500 group-hover:scale-[1.035]" loading="lazy" />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-sky-700">{product.brand}</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{product.technology}</span>
                  </div>
                  <h3 class="mt-4 text-xl font-bold tracking-[-0.03em] text-slate-950">{product.name}</h3>
                  <p class="mt-2 text-sm font-semibold text-slate-500">{product.category}</p>
                  <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{product.summary}</p>
                  <div class="mt-5 border-t border-slate-200 pt-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Aplicación</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">{product.application}</p>
                  </div>
                  <span class="mt-5 inline-flex w-fit items-center rounded-full border border-sky-300 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-800">
                    Ver detalle
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-8 hidden rounded-[8px] border border-slate-200 bg-slate-50 p-5 text-sm font-semibold text-slate-600" data-catalog-empty>
        No hay productos con estos filtros.
      </p>
    </div>
  </div>
</section>

<script>
  const catalogs = document.querySelectorAll('[data-product-catalog]');

  catalogs.forEach((catalog) => {
    const searchInput = catalog.querySelector('[data-catalog-search]');
    const brandSelect = catalog.querySelector('[data-catalog-brand]');
    const categorySelect = catalog.querySelector('[data-catalog-category]');
    const technologySelect = catalog.querySelector('[data-catalog-technology]');
    const sortSelect = catalog.querySelector('[data-catalog-sort]');
    const resetButton = catalog.querySelector('[data-catalog-reset]');
    const countNode = catalog.querySelector('[data-catalog-count]');
    const emptyNode = catalog.querySelector('[data-catalog-empty]');
    const grid = catalog.querySelector('[data-catalog-grid]');
    const familyButtons = Array.from(catalog.querySelectorAll('[data-catalog-family]'));
    const cards = Array.from(catalog.querySelectorAll('[data-catalog-card]'));
    let selectedFamily = '';

    const setActiveFamily = () => {
      familyButtons.forEach((button) => {
        const isActive = button.value === selectedFamily;
        button.classList.toggle('border-sky-700', isActive);
        button.classList.toggle('bg-sky-700', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('border-slate-300', !isActive);
        button.classList.toggle('bg-white', !isActive);
        button.classList.toggle('text-slate-700', !isActive);
      });
    };

    const applyFilters = () => {
      const term = searchInput.value.trim().toLowerCase();
      const brand = brandSelect.value;
      const category = categorySelect.value;
      const technology = technologySelect.value;
      const sortKey = sortSelect.value;
      let visibleCount = 0;

      cards
        .sort((a, b) => {
          const aValue = a.dataset[sortKey] || '';
          const bValue = b.dataset[sortKey] || '';
          return aValue.localeCompare(bValue, 'es');
        })
        .forEach((card) => {
          grid.appendChild(card);
          const matches =
            (!term || card.dataset.search.includes(term)) &&
            (!brand || card.dataset.brand === brand) &&
            (!selectedFamily || card.dataset.family === selectedFamily) &&
            (!category || card.dataset.category === category) &&
            (!technology || card.dataset.technology === technology);

          card.classList.toggle('hidden', !matches);
          if (matches) visibleCount += 1;
        });

      countNode.textContent = String(visibleCount);
      emptyNode.classList.toggle('hidden', visibleCount > 0);
      setActiveFamily();
    };

    searchInput.addEventListener('input', applyFilters);
    brandSelect.addEventListener('change', applyFilters);
    categorySelect.addEventListener('change', applyFilters);
    technologySelect.addEventListener('change', applyFilters);
    sortSelect.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      searchInput.value = '';
      brandSelect.value = '';
      categorySelect.value = '';
      technologySelect.value = '';
      sortSelect.value = 'name';
      selectedFamily = '';
      applyFilters();
    });
    familyButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedFamily = button.value;
        applyFilters();
      });
    });

    applyFilters();
  });
</script>
