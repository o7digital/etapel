---
import { catalogProducts, productDetailPath } from '../data/products';
import { productFamilies } from '../data/productLines';

interface Props {
  familySlug?: string;
}

const { familySlug } = Astro.props as Props;
const initialProducts = familySlug
  ? catalogProducts.filter((product) => product.familySlug === familySlug)
  : catalogProducts;
const activeFamily = familySlug ? productFamilies.find((family) => family.slug === familySlug) : undefined;
const interests = Array.from(new Set(initialProducts.map((product) => product.interest || product.category))).sort();
const patterns = Array.from(new Set(initialProducts.map((product) => product.sprayPattern || 'Standard'))).sort();
const nozzleTechnologies = Array.from(new Set(initialProducts.map((product) => product.nozzleTechnology || product.technology))).sort();
const defaultInterest = interests.includes('Pistolas con vaso de gravedad')
  ? 'Pistolas con vaso de gravedad'
  : interests[0];
---

<section id="catalogo-productos" class="bg-white py-16 sm:py-20">
  <div class="shell">
    <div class="max-w-4xl">
      <span class="section-kicker text-slate-700">Catálogo de productos</span>
      <h2 class="section-title mt-4 text-slate-950">
        {activeFamily ? activeFamily.shortTitle : 'Productos Etapel'}
      </h2>
      <p class="mt-5 text-base leading-8 text-slate-600">
        Filtra por tipo de producto, forma del abanico y tecnología. Cada tarjeta abre una ficha con opciones, galería, datos técnicos y recursos.
      </p>
    </div>

    <div class="mt-10 bg-[#eaf6ff] p-6 sm:p-8" data-product-catalog>
      <h3 class="text-2xl font-bold tracking-[-0.03em] text-slate-950">¿Qué te interesa?</h3>
      <div class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
        {interests.map((interest) => (
          <button
            type="button"
            value={interest}
            data-interest-filter
            class={`min-h-[64px] border bg-white px-4 py-3 text-sm font-bold uppercase text-slate-950 transition hover:border-slate-950 ${interest === defaultInterest ? 'border-slate-950 ring-1 ring-slate-950' : 'border-slate-300'}`}
          >
            {interest}
          </button>
        ))}
      </div>

      <div class="mt-12 bg-white p-0">
        <div class="flex flex-col gap-6 border-b border-slate-200 pb-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">
              <span data-catalog-count>{initialProducts.length}</span> Resultados
            </p>
          </div>

          <label class="block w-full max-w-sm">
            <span class="mb-2 block text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Buscar</span>
            <input
              type="search"
              data-catalog-search
              class="field-input rounded-none"
              placeholder="Buscar por producto, uso o marca"
            />
          </label>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <label class="block min-w-[230px]">
            <span class="sr-only">Forma del abanico</span>
            <select data-pattern-filter class="field-select rounded-none">
              <option value="">Forma del abanico</option>
              {patterns.map((pattern) => <option value={pattern}>{pattern}</option>)}
            </select>
          </label>
          <label class="block min-w-[250px]">
            <span class="sr-only">Tecnología de boquillas</span>
            <select data-nozzle-filter class="field-select rounded-none">
              <option value="">Tecnología de boquillas</option>
              {nozzleTechnologies.map((technology) => <option value={technology}>{technology}</option>)}
            </select>
          </label>
        </div>

        <div class="mt-5 flex flex-wrap gap-2" data-active-filters></div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4" data-catalog-grid>
          {initialProducts.map((product) => (
            <article
              data-catalog-card
              data-name={product.name.toLowerCase()}
              data-interest={product.interest || product.category}
              data-pattern={product.sprayPattern || 'Standard'}
              data-nozzle={product.nozzleTechnology || product.technology}
              data-search={`${product.name} ${product.brand} ${product.category} ${product.technology} ${product.application} ${product.summary}`.toLowerCase()}
              class="group relative flex min-h-[430px] flex-col overflow-hidden border border-slate-200 bg-white transition hover:border-slate-950"
            >
              <a href={productDetailPath(product)} class="flex h-full flex-col">
                <div class="flex h-64 items-center justify-center bg-[#f6f6f6] p-6">
                  <img src={product.image} alt={product.name} class="max-h-full w-full object-contain transition duration-500 group-hover:scale-[1.035]" loading="lazy" />
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <p class="text-sm leading-6 text-slate-500">{product.interest || product.category}</p>
                  <h3 class="mt-2 text-xl font-semibold tracking-[-0.03em] text-slate-950">{product.name}</h3>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{product.summary}</p>
                  <span class="mt-auto flex h-12 w-12 items-center justify-center self-end bg-black text-2xl font-bold text-white transition group-hover:bg-sky-700">
                    →
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>

        <p class="mt-8 hidden border border-slate-200 bg-slate-50 p-5 text-sm font-semibold text-slate-600" data-catalog-empty>
          No hay productos con estos filtros.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const defaultInterest = 'Pistolas con vaso de gravedad';

  document.querySelectorAll('[data-product-catalog]').forEach((catalog) => {
    const interestButtons = Array.from(catalog.querySelectorAll('[data-interest-filter]'));
    const patternSelect = catalog.querySelector('[data-pattern-filter]');
    const nozzleSelect = catalog.querySelector('[data-nozzle-filter]');
    const searchInput = catalog.querySelector('[data-catalog-search]');
    const countNode = catalog.querySelector('[data-catalog-count]');
    const activeFilters = catalog.querySelector('[data-active-filters]');
    const emptyNode = catalog.querySelector('[data-catalog-empty]');
    const cards = Array.from(catalog.querySelectorAll('[data-catalog-card]'));
    let selectedInterest =
      interestButtons.find((button) => button.value === defaultInterest)?.value ||
      interestButtons[0]?.value ||
      '';

    const chip = (label, value, onClear) => {
      if (!value) return null;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-800 transition hover:bg-slate-200';
      button.textContent = `${label} ×`;
      button.addEventListener('click', onClear);
      return button;
    };

    const renderChips = () => {
      activeFilters.innerHTML = '';
      const chips = [
        chip(selectedInterest, selectedInterest, () => {
          selectedInterest = '';
          applyFilters();
        }),
        chip(patternSelect.value, patternSelect.value, () => {
          patternSelect.value = '';
          applyFilters();
        }),
        chip(nozzleSelect.value, nozzleSelect.value, () => {
          nozzleSelect.value = '';
          applyFilters();
        })
      ].filter(Boolean);

      chips.forEach((item) => activeFilters.appendChild(item));

      if (chips.length > 0) {
        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'rounded-full bg-sky-50 px-4 py-2 text-sm font-semibold text-slate-800 transition hover:bg-sky-100';
        reset.textContent = 'Reset all ×';
        reset.addEventListener('click', () => {
          selectedInterest = '';
          patternSelect.value = '';
          nozzleSelect.value = '';
          searchInput.value = '';
          applyFilters();
        });
        activeFilters.appendChild(reset);
      }
    };

    const syncButtons = () => {
      interestButtons.forEach((button) => {
        const active = button.value === selectedInterest;
        button.classList.toggle('border-slate-950', active);
        button.classList.toggle('ring-1', active);
        button.classList.toggle('ring-slate-950', active);
        button.classList.toggle('border-slate-300', !active);
      });
    };

    const applyFilters = () => {
      const term = searchInput.value.trim().toLowerCase();
      let count = 0;

      cards.forEach((card) => {
        const matches =
          (!selectedInterest || card.dataset.interest === selectedInterest) &&
          (!patternSelect.value || card.dataset.pattern === patternSelect.value) &&
          (!nozzleSelect.value || card.dataset.nozzle === nozzleSelect.value) &&
          (!term || card.dataset.search.includes(term));

        card.classList.toggle('hidden', !matches);
        if (matches) count += 1;
      });

      countNode.textContent = String(count);
      emptyNode.classList.toggle('hidden', count > 0);
      syncButtons();
      renderChips();
    };

    interestButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectedInterest = selectedInterest === button.value ? '' : button.value;
        applyFilters();
      });
    });
    patternSelect.addEventListener('change', applyFilters);
    nozzleSelect.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
    applyFilters();
  });
</script>
