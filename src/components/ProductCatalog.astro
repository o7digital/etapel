---
import { catalogProducts } from '../data/products';
import { productFamilies } from '../data/productLines';

const familiesWithProducts = productFamilies.filter((family) =>
  catalogProducts.some((product) => product.familySlug === family.slug)
);

const featuredProduct = catalogProducts[0];
---

<section id="catalogo-productos" class="bg-[#f6f9fc] py-16 sm:py-20">
  <div class="shell">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div>
        <span class="section-kicker text-slate-700">Catálogo de productos</span>
        <h2 class="section-title mt-4 text-slate-950">
          Sistema de consulta para productos SATA y líneas distribuidas por Etapel
        </h2>
        <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
          Una vista comercial para explorar productos por familia, marca y aplicación. La estructura queda lista para crecer con fichas, variantes, fotografías oficiales y documentación técnica.
        </p>
      </div>

      <div class="rounded-[8px] border border-slate-200 bg-white p-5 shadow-[0_18px_50px_rgba(15,23,42,0.06)]">
        <div class="grid gap-3 sm:grid-cols-3">
          <div>
            <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">{catalogProducts.length}</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Productos base</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">SATA</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Marca destacada</p>
          </div>
          <div>
            <p class="text-3xl font-bold tracking-[-0.04em] text-slate-950">{familiesWithProducts.length}</p>
            <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Familias activas</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-3" aria-label="Filtros de catálogo">
      <a href="#catalogo-productos" class="rounded-full border border-sky-700 bg-sky-700 px-4 py-2 text-sm font-semibold text-white">
        Todos
      </a>
      {
        familiesWithProducts.map((family) => (
          <a href={`#${family.slug}`} class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700">
            {family.shortTitle}
          </a>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="overflow-hidden rounded-[8px] border border-slate-200 bg-white shadow-[0_22px_60px_rgba(15,23,42,0.07)]">
        <div class="bg-slate-50 p-6">
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-sky-700">Producto destacado</p>
          <h3 class="mt-3 text-3xl font-bold tracking-[-0.04em] text-slate-950">{featuredProduct.name}</h3>
          <p class="mt-3 text-base leading-7 text-slate-600">{featuredProduct.summary}</p>
        </div>
        <div class="aspect-[4/3] bg-white p-8">
          <img src={featuredProduct.image} alt={featuredProduct.name} class="h-full w-full object-contain" loading="lazy" />
        </div>
        <div class="border-t border-slate-200 p-6">
          <div class="flex flex-wrap gap-2">
            {featuredProduct.badges.map((badge) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">{badge}</span>)}
          </div>
          <p class="mt-5 text-sm leading-7 text-slate-600">{featuredProduct.description}</p>
          <a href="/contacto" class="btn-primary mt-6">Solicitar información</a>
        </div>
      </article>

      <div class="grid gap-4 md:grid-cols-2">
        {
          catalogProducts.map((product) => (
            <article id={product.familySlug} class="group flex min-h-[360px] flex-col overflow-hidden rounded-[8px] border border-slate-200 bg-white shadow-[0_16px_44px_rgba(15,23,42,0.05)] transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_24px_70px_rgba(14,116,144,0.10)]">
              <div class="flex h-52 items-center justify-center bg-slate-50 p-6">
                <img src={product.image} alt={product.name} class="max-h-full w-full object-contain transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-xs font-bold uppercase tracking-[0.22em] text-sky-700">{product.brand}</p>
                  <p class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{product.category}</p>
                </div>
                <h3 class="mt-4 text-xl font-bold tracking-[-0.03em] text-slate-950">{product.name}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-600">{product.summary}</p>
                <dl class="mt-5 grid gap-3 border-t border-slate-200 pt-5">
                  {product.specs.slice(0, 2).map((spec) => (
                    <div class="grid grid-cols-[92px_1fr] gap-3 text-sm">
                      <dt class="font-semibold text-slate-500">{spec.label}</dt>
                      <dd class="text-slate-800">{spec.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
