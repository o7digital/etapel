---
import { productFamiliesEn } from '../../data/productLinesEn';

const services = [
  { label: 'Training', href: '/en/training' },
  { label: 'After-Sales', href: '/en/after-sales' }
];

const contactLinks = [
  { label: 'ventas@etapel.com.mx', href: 'mailto:ventas@etapel.com.mx' },
  { label: '+52 55 5689 5055', href: 'tel:+525556895055' },
  { label: 'WhatsApp', href: 'https://wa.link/oowyzu' }
];
---

<footer class="border-t border-slate-300/80 bg-[#d6e1ea] pb-8 pt-14 text-slate-900">
  <div class="shell">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.95fr_0.8fr_0.9fr]">
      <div>
        <img src="/images/logo-etapel.webp" alt="Etapel" class="h-12 w-auto" loading="lazy" />
        <p class="mt-6 max-w-md text-base leading-8 text-slate-800">
          At Etapel, we are more than suppliers, we are growth partners for your business.
        </p>
        <p class="mt-4 max-w-md text-sm leading-7 text-slate-700">
          Discover how we can help you reach new performance levels.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Product line</h3>
        <ul class="mt-5 space-y-3">
          {
            productFamiliesEn.map((family) => (
              <li>
                <a href={family.href} class="text-sm text-slate-800 transition hover:text-sky-700">
                  {family.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Services</h3>
        <ul class="mt-5 space-y-3">
          {
            services.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-slate-800 transition hover:text-sky-700">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.26em] text-slate-900">Contact</h3>
        <ul class="mt-5 space-y-3">
          {
            contactLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-slate-800 transition hover:text-sky-700"
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-slate-300/80 pt-6 text-sm text-slate-700 sm:flex-row sm:items-center sm:justify-between">
      <p>Copyright © 2026 Etapel. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/en/contact" class="transition hover:text-sky-700">Need help? Contact us</a>
        <a href="/en/privacy-notice" class="transition hover:text-sky-700">Privacy Notice</a>
        <a href="/" class="transition hover:text-sky-700">Versión en Español</a>
      </div>
    </div>
  </div>
</footer>
