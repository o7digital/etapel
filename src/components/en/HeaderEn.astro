---
import { productFamiliesEn } from '../../data/productLinesEn';

const navItems = [
  { label: 'Home', href: '/en' },
  { label: 'Who We Are', href: '/en/#who-we-are' },
  { label: 'Training', href: '/en/training' },
  { label: 'After-Sales', href: '/en/after-sales' },
  { label: 'Contact', href: '/en/contact' }
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="w-full">
    <div class="rounded-none border-b border-white/10 bg-[#061018]/88 px-5 py-3 shadow-[0_16px_50px_rgba(0,0,0,0.32)] backdrop-blur-xl sm:px-8 lg:px-12">
      <div class="flex items-center justify-between gap-4">
        <a href="/en" class="shrink-0 transition-opacity hover:opacity-80" aria-label="Go to homepage">
          <img
            src="/images/logo-etapel-white.webp"
            alt="Etapel"
            class="h-10 w-auto sm:h-11"
            loading="eager"
          />
        </a>

        <nav class="hidden lg:block" aria-label="Main navigation">
          <ul class="flex items-center gap-6 text-sm font-semibold text-slate-100">
            <li>
              <a
                href="/en"
                class="relative py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 hover:after:scale-x-100"
              >
                Home
              </a>
            </li>

            <li class="group relative">
              <a
                href="/en/product-line"
                class="relative inline-flex items-center gap-2 py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 group-hover:after:scale-x-100 hover:after:scale-x-100"
              >
                Product Line
                <svg class="h-4 w-4 transition duration-300 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.513a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
                </svg>
              </a>

              <div class="pointer-events-none absolute left-1/2 top-full z-50 w-[min(1100px,calc(100vw-3rem))] -translate-x-1/2 px-4 pt-4 opacity-0 transition duration-200 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
                <div class="grid gap-6 rounded-[6px] border border-slate-200 bg-white p-6 text-slate-900 shadow-[0_28px_80px_rgba(15,23,42,0.16)] xl:grid-cols-[1.4fr_0.6fr]">
                  <div>
                    <div class="mb-6">
                      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-700">Product Line</p>
                      <h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-950">Four main families</h3>
                      <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-500">
                        A simple navigation to find the right category without turning the menu into a catalog.
                      </p>
                    </div>

                    <div class="grid gap-4 md:grid-cols-2">
                      {
                        productFamiliesEn.map((family) => (
                          <a
                            href={family.href}
                            class="group rounded-[6px] border border-slate-200 bg-slate-50 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-sky-200 hover:bg-sky-50"
                          >
                            <p class="text-base font-bold tracking-[-0.02em] text-slate-950">{family.title}</p>
                            <p class="mt-2 text-sm leading-7 text-slate-600">{family.menuDescription}</p>
                            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition duration-300 group-hover:text-sky-700">
                              View category
                              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M7.22 4.97a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06L11.19 10 7.22 6.03a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
                              </svg>
                            </span>
                          </a>
                        ))
                      }
                    </div>
                  </div>

                  <div class="rounded-[6px] border border-slate-200 bg-[linear-gradient(180deg,#f7fbff,#edf5fb)] p-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-700">Quick access</p>
                    <h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-slate-950">Light navigation</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-600">
                      Explore the four families or enter the central hub to orient your search.
                    </p>
                    <div class="mt-6 grid gap-3">
                      <a href="/en/product-line" class="btn-outline justify-center">View all lines</a>
                      <a href="/en/contact" class="btn-primary justify-center">Talk to an advisor</a>
                    </div>
                  </div>
                </div>
              </div>
            </li>

            {
              navItems.slice(1).map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="relative py-2 text-slate-200 transition duration-300 hover:text-cyan-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-cyan-300 after:transition-transform after:duration-300 hover:after:scale-x-100"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/en/contact"
            class="hidden rounded-[6px] border border-cyan-300/30 bg-cyan-300/10 px-5 py-3 text-sm font-semibold text-cyan-100 transition duration-300 hover:-translate-y-0.5 hover:bg-cyan-300/20 sm:inline-flex"
          >
            Request info
          </a>

          <a
            href="/"
            class="hidden rounded-[6px] border border-white/20 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-white/10 sm:inline-flex"
            aria-label="Cambiar a español"
          >
            ES
          </a>

          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-[6px] border border-white/12 bg-white/5 text-white transition hover:bg-white/10 lg:hidden"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden pt-4 lg:hidden" data-menu-panel>
        <nav aria-label="Mobile navigation">
          <ul class="grid gap-2 rounded-[6px] border border-white/10 bg-white/5 p-3 text-sm font-semibold text-slate-100">
            <li>
              <a href="/en" class="block rounded-[6px] px-4 py-3 transition hover:bg-white/10">Home</a>
            </li>

            <li>
              <details class="rounded-[6px] border border-white/10 bg-white/5 p-1">
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-[6px] px-4 py-3">
                  <span>Product Line</span>
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.513a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"></path>
                  </svg>
                </summary>
                <div class="grid gap-2 px-3 pb-3 pt-2 text-sm">
                  <a href="/en/product-line" class="rounded-[6px] border border-white/10 bg-white/5 px-4 py-3 text-cyan-100">
                    View all product lines
                  </a>
                  {
                    productFamiliesEn.map((family) => (
                      <a href={family.href} class="rounded-[6px] px-4 py-3 text-slate-200 transition hover:bg-white/10">
                        <span class="block font-semibold">{family.title}</span>
                        <span class="mt-1 block text-xs leading-6 text-slate-400">{family.menuDescription}</span>
                      </a>
                    ))
                  }
                  <a href="/en/contact" class="rounded-[6px] border border-white/10 bg-white/5 px-4 py-3 text-slate-200 transition hover:bg-white/10">
                    Talk to an advisor
                  </a>
                </div>
              </details>
            </li>

            {
              navItems.slice(1).map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-[6px] px-4 py-3 transition hover:bg-white/10"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href="/en/contact"
                class="mt-2 inline-flex w-full justify-center rounded-[6px] border border-cyan-300/30 bg-cyan-300/10 px-5 py-3 text-sm font-semibold text-cyan-100 transition duration-300 hover:bg-cyan-300/20"
              >
                Request info
              </a>
            </li>
            <li>
              <a href="/" class="block rounded-[6px] border border-white/10 bg-white/5 px-4 py-3 text-center text-slate-100 transition hover:bg-white/10">
                Ver en Español
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');

  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      panel.classList.toggle('hidden', isOpen);
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.classList.add('hidden');
      });
    });
  }
</script>
