---
import { productFamiliesEn } from '../../data/productLinesEn';
---

<section id="product-line" class="bg-[#f3f7fb] py-16 sm:py-20">
  <div class="shell">
    <div class="mx-auto max-w-3xl text-center">
      <span class="section-kicker justify-center text-slate-700">Product lines</span>
      <h2 class="section-title mt-4 text-slate-950">OUR TECHNOLOGY IS EXTRAORDINARY</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-600">
        We offer leading global brands in major equipment, tools, consumables, and paint systems.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        productFamiliesEn.map((family) => (
          <article class="flex h-full flex-col overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_18px_50px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1">
            <div class="media-frame-soft h-[250px] rounded-none border-x-0 border-t-0 shadow-none">
              <img
                src={family.image}
                alt={family.title}
                class="media-cover"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <h3 class="text-2xl font-bold tracking-[-0.03em] text-slate-950">
                {family.title}
              </h3>
              <p class="mt-4 text-sm leading-7 text-slate-600">
                {family.menuDescription}
              </p>
              <ul class="mt-5 space-y-2 text-sm text-slate-500">
                {family.items.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
              <div class="mt-auto pt-7">
                <a href={family.href} class="btn-outline">LEARN MORE</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a href="/en/product-line" class="btn-primary">View all product lines</a>
    </div>
  </div>
</section>
