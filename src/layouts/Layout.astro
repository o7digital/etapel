---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: string;
  ogLocale?: string;
  keywords?: string[];
}

const {
  title,
  description,
  image = '/images/featured-lineas.webp',
  noindex = false,
  lang = 'es',
  ogLocale = 'es_MX',
  keywords
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL(image, Astro.site).toString();
const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : `${Astro.url.origin}/`;

const keywordsEs = [
  'pintura automotriz CDMX',
  'repintado automotriz CDMX',
  'taller automotriz CDMX',
  'equipo para taller CDMX',
  'cabina de pintura CDMX',
  'pistola de pintura CDMX',
  'consumibles de pintura CDMX',
  'soldadura automotriz CDMX',
  'aire comprimido CDMX',
  'capacitación automotriz CDMX',
  'procesos homologados CDMX',
  'postventa automotriz CDMX',
  'mantenimiento de equipos CDMX',
  'soporte técnico CDMX',
  'tecnología para taller CDMX',
  'soluciones para carrocería CDMX',
  'servicio técnico especializado CDMX',
  'centro de capacitación CDMX',
  'soluciones certificadas CDMX',
  'cotización de equipos automotrices CDMX'
];

const keywordsEn = [
  'automotive paint CDMX',
  'automotive refinishing CDMX',
  'automotive workshop CDMX',
  'workshop equipment CDMX',
  'paint booth CDMX',
  'spray gun CDMX',
  'paint consumables CDMX',
  'automotive welding CDMX',
  'compressed air CDMX',
  'automotive training CDMX',
  'homologated processes CDMX',
  'automotive after-sales CDMX',
  'equipment maintenance CDMX',
  'technical support CDMX',
  'workshop technology CDMX',
  'body shop solutions CDMX',
  'specialized technical service CDMX',
  'training center CDMX',
  'certified solutions CDMX',
  'automotive equipment quote CDMX'
];

const selectKeywords = (pathname: string, currentLang: string) => {
  if (currentLang === 'en') {
    if (pathname.startsWith('/en/contact')) {
      return [
        'automotive commercial contact CDMX',
        'technical consulting CDMX',
        'commercial consulting CDMX',
        'automotive supplier CDMX',
        'automotive equipment quote CDMX',
        'technical support CDMX'
      ];
    }

    if (pathname.startsWith('/en/training')) {
      return [
        'automotive training CDMX',
        'paint training CDMX',
        'training center CDMX',
        'homologated processes CDMX',
        'workshop safety CDMX',
        'operational efficiency CDMX'
      ];
    }

    if (pathname.startsWith('/en/after-sales')) {
      return [
        'automotive after-sales CDMX',
        'equipment maintenance CDMX',
        'equipment repair CDMX',
        'equipment installation CDMX',
        'specialized technical service CDMX',
        'technical support CDMX'
      ];
    }

    if (pathname.startsWith('/en/product-line/')) {
      return [
        'workshop equipment CDMX',
        'body shop solutions CDMX',
        'professional paint equipment CDMX',
        'automotive tools CDMX',
        'industrial solutions CDMX',
        'automotive equipment distribution CDMX'
      ];
    }

    return keywordsEn;
  }

  if (pathname.startsWith('/contacto')) {
    return [
      'contacto comercial automotriz CDMX',
      'asesoría técnica CDMX',
      'asesoría comercial CDMX',
      'proveedor automotriz CDMX',
      'cotización de equipos automotrices CDMX',
      'soporte técnico CDMX'
    ];
  }

  if (pathname.startsWith('/capacitacion')) {
    return [
      'capacitación automotriz CDMX',
      'capacitación en pintura CDMX',
      'centro de capacitación CDMX',
      'procesos homologados CDMX',
      'seguridad en taller CDMX',
      'eficiencia operativa CDMX'
    ];
  }

  if (pathname.startsWith('/postventa')) {
    return [
      'postventa automotriz CDMX',
      'mantenimiento de equipos CDMX',
      'reparación de equipos CDMX',
      'instalación de equipos CDMX',
      'servicio técnico especializado CDMX',
      'soporte técnico CDMX'
    ];
  }

  if (pathname.startsWith('/linea-de-producto/')) {
    return [
      'equipo para taller CDMX',
      'soluciones para carrocería CDMX',
      'equipo de pintura profesional CDMX',
      'herramientas automotrices CDMX',
      'soluciones industriales CDMX',
      'distribución de equipos automotrices CDMX'
    ];
  }

  return keywordsEs;
};

const pageKeywords = keywords && keywords.length > 0
  ? keywords
  : selectKeywords(Astro.url.pathname, lang);

const siteName = lang === 'en' ? 'Etapel | Official Site' : 'Etapel | Sitio Oficial';

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: lang,
  keywords: pageKeywords,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Etapel',
    url: siteUrl
  }
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={pageKeywords.join(', ')} />
    <meta name="theme-color" content="#050b12" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <main
      style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#fff;color:#111;font-family:Manrope,sans-serif;font-size:clamp(2rem,6vw,4rem);font-weight:700;text-transform:lowercase;"
    >
      sitio suspendido
    </main>
  </body>
</html>
