---
import Layout from '../../layouts/Layout.astro';
import HeaderEn from '../../components/en/HeaderEn.astro';
import FooterEn from '../../components/en/FooterEn.astro';

const offices = ['Monterrey', 'Mexico City', 'Veracruz'];

const topics = [
  'Special offers subscription',
  'Personalized support',
  'Complaints or suggestions'
];
---

<Layout
  title="Automotive commercial contact in CDMX | Etapel Official Site"
  description="Contact Etapel Official Site for automotive commercial and technical advisory in CDMX via WhatsApp, email, phone, and contact form."
  lang="en"
  ogLocale="en_US"
>
  <HeaderEn />

  <main class="bg-white">
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#eef5fb_100%)] pb-18 pt-32 sm:pb-22 sm:pt-36">
      <div class="shell">
        <div class="grid items-center gap-10 lg:grid-cols-[0.92fr_1.08fr]">
          <div>
            <span class="section-kicker text-slate-700">CONTACT AN EXPERT</span>
            <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
              We are here to help
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
              Reach out for commercial support, follow-up, and guidance on Etapel solutions.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="mailto:ventas@etapel.com.mx" class="btn-primary">ventas@etapel.com.mx</a>
              <a href="https://wa.link/oowyzu" class="btn-outline" target="_blank" rel="noreferrer">WhatsApp</a>
            </div>
          </div>

          <div class="media-frame">
            <img
              src="/images/contacto-etapel.webp"
              alt="Etapel team"
              class="media-cover h-[320px] object-[center_35%] sm:h-[420px] lg:h-[520px]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
          <div>
            <div class="grid gap-5 md:grid-cols-3">
              {
                offices.map((office) => (
                  <article class="surface-card-soft p-6">
                    <span class="section-kicker text-slate-700">{office}</span>
                  </article>
                ))
              }
            </div>

            <div class="surface-card mt-6 p-7">
              <h2 class="text-2xl font-bold tracking-[-0.03em] text-slate-950">Contact details</h2>
              <div class="mt-5 grid gap-4 text-base text-slate-600 sm:grid-cols-2">
                <div class="surface-card-soft p-5">
                  <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">Email</p>
                  <a href="mailto:ventas@etapel.com.mx" class="mt-3 block text-lg font-semibold text-slate-950 transition hover:text-sky-700">
                    ventas@etapel.com.mx
                  </a>
                </div>
                <div class="surface-card-soft p-5">
                  <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">Phone</p>
                  <a href="tel:+525556895055" class="mt-3 block text-lg font-semibold text-slate-950 transition hover:text-sky-700">
                    +52 55 5689 5055
                  </a>
                </div>
              </div>
              <div class="mt-5">
                <a href="https://wa.link/oowyzu" class="btn-outline" target="_blank" rel="noreferrer">Contact us</a>
              </div>
            </div>
          </div>

          <div class="media-frame">
            <img
              src="/images/mapa-etapel.webp"
              alt="Etapel location reference map"
              class="media-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f4f8fc] py-18 sm:py-22">
      <div class="shell">
        <div class="surface-card grid gap-8 p-8 sm:p-10 lg:grid-cols-[0.85fr_1.15fr]">
          <div>
            <span class="section-kicker text-slate-700">Form</span>
            <h2 class="section-title mt-4 text-slate-950">Contact us, we’re here to help</h2>
            <p class="mt-5 text-base leading-8 text-slate-600">
              Share your details and the topic you need support on.
            </p>
          </div>

          <form class="grid gap-4">
            <input class="field-input" type="text" name="name" placeholder="Name *" />
            <input class="field-input" type="text" name="company" placeholder="Company" />
            <input class="field-input" type="tel" name="phone" placeholder="Phone" />
            <input class="field-input" type="email" name="email" placeholder="Email *" />
            <select class="field-select" name="topic">
              <option value="">Select the topic you need information about *</option>
              {topics.map((topic) => <option value={topic}>{topic}</option>)}
            </select>
            <textarea class="field-textarea" name="message" placeholder="Optional message"></textarea>
            <button type="submit" class="btn-primary w-full sm:w-auto">Send</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <FooterEn />
</Layout>
