---
import Layout from '../../../layouts/Layout.astro';
import HeaderEn from '../../../components/en/HeaderEn.astro';
import FooterEn from '../../../components/en/FooterEn.astro';
import { productFamiliesEn, type ProductFamilyEn } from '../../../data/productLinesEn';

export function getStaticPaths() {
  return productFamiliesEn.map((family) => ({
    params: { slug: family.slug },
    props: { family }
  }));
}

const { family } = Astro.props as { family: ProductFamilyEn };
---

<Layout
  title={`${family.title} | Product Line | Etapel`}
  description={family.pageDescription}
  lang="en"
  ogLocale="en_US"
>
  <HeaderEn />

  <main class="bg-white">
    <section class={`bg-gradient-to-br ${family.accent} from-white via-slate-50 to-white pb-16 pt-32 sm:pb-20 sm:pt-36`}>
      <div class="shell">
        <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div>
            <a href="/en/product-line" class="text-sm font-semibold text-cyan-700 transition hover:text-cyan-800">
              ← Back to Product Line
            </a>
            <span class="section-kicker mt-6 text-slate-700">{family.title}</span>
            <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
              {family.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
              {family.pageDescription}
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/en/contact" class="btn-primary">Request information</a>
              <a href="/en/product-line" class="btn-outline">View all lines</a>
            </div>
          </div>

          <div class="media-frame">
            <img src={family.image} alt={family.title} class="media-cover h-[320px] sm:h-[420px]" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="max-w-3xl">
          <span class="section-kicker text-slate-700">Subproducts</span>
          <h2 class="section-title mt-4 text-slate-950">Subfamilies and solutions</h2>
          <p class="mt-5 text-base leading-8 text-slate-600">
            This category groups key sub-lines to guide navigation and present Etapel's offer with greater clarity.
          </p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            family.items.map((item, index) => (
              <article class="rounded-[28px] border border-slate-200 bg-slate-50 p-6 shadow-[0_14px_40px_rgba(15,23,42,0.05)]">
                <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-sm font-bold text-cyan-700 shadow-[0_10px_20px_rgba(15,23,42,0.06)]">
                  {String(index + 1).padStart(2, '0')}
                </div>
                <h3 class="mt-5 text-xl font-bold tracking-[-0.03em] text-slate-950">{item}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-600">
                  Integrated line within {family.shortTitle.toLowerCase()} to deliver clearer presentation and easier navigation for users.
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-[#f3f7fb] py-16 sm:py-20">
      <div class="shell">
        <div class="rounded-[34px] border border-slate-200 bg-white px-8 py-10 shadow-[0_22px_60px_rgba(15,23,42,0.06)] sm:px-10 sm:py-12">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-3xl">
              <h2 class="text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">
                Need help choosing the right line?
              </h2>
              <p class="mt-4 text-base leading-8 text-slate-600">
                Our team can guide you based on workshop type, process, and equipment needs.
              </p>
            </div>
            <a href="/en/contact" class="btn-primary">Talk to an advisor</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterEn />
</Layout>
