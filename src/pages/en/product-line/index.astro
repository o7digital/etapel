---
import Layout from '../../../layouts/Layout.astro';
import HeaderEn from '../../../components/en/HeaderEn.astro';
import FooterEn from '../../../components/en/FooterEn.astro';
import { productFamiliesEn } from '../../../data/productLinesEn';
---

<Layout
  title="Product Line | Etapel"
  description="Main hub of Etapel product lines with clear navigation by family."
  lang="en"
  ogLocale="en_US"
>
  <HeaderEn />

  <main class="bg-white">
    <section class="relative overflow-hidden bg-[linear-gradient(180deg,#f8fbff_0%,#eef5fb_100%)] pb-16 pt-32 sm:pb-20 sm:pt-36">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(125,211,252,0.18),transparent_28%),radial-gradient(circle_at_80%_20%,rgba(191,219,254,0.2),transparent_22%)]"></div>
      <div class="absolute inset-0 opacity-40">
        <div class="h-full w-full bg-[linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:48px_48px]"></div>
      </div>
      <div class="shell">
        <div class="relative grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div class="max-w-4xl">
            <span class="section-kicker text-slate-700">Product line</span>
            <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
              Product Line
            </h1>
            <p class="mt-4 max-w-2xl text-xl font-semibold tracking-[-0.03em] text-slate-800">
              Solutions organized by family to guide your search faster.
            </p>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
              Find the right line for your operation with a clearer structure and easier navigation.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/en/contact" class="btn-primary">Request information</a>
              <a href="#families" class="btn-outline">View families</a>
            </div>
          </div>

          <div class="rounded-[34px] border border-slate-200 bg-white/85 p-8 shadow-[0_24px_70px_rgba(15,23,42,0.08)] backdrop-blur">
            <div class="grid gap-4 sm:grid-cols-2">
              {
                productFamiliesEn.map((family) => (
                  <div class="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
                    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">{family.shortTitle}</p>
                    <p class="mt-3 text-base font-semibold text-slate-900">{family.title}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="families" class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <span class="section-kicker justify-center text-slate-700">Main families</span>
          <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">
            Four clear entry points without turning navigation into a catalog
          </h2>
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          {
            productFamiliesEn.map((family) => (
              <article class="group overflow-hidden rounded-[36px] border border-slate-200 bg-white shadow-[0_20px_60px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1 hover:border-sky-200 hover:shadow-[0_28px_80px_rgba(14,116,144,0.10)]">
                <div class="grid min-h-[420px] lg:grid-cols-[1.02fr_0.98fr]">
                  <div class="flex flex-col justify-between p-8 sm:p-10">
                    <div>
                      <span class="section-kicker text-slate-700">{family.shortTitle}</span>
                      <h2 class="mt-5 text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">
                        {family.title}
                      </h2>
                      <p class="mt-5 max-w-md text-base leading-8 text-slate-600">
                        {family.menuDescription}
                      </p>
                    </div>

                    <div class="mt-8">
                      <a href={family.href} class="btn-outline">View category</a>
                    </div>
                  </div>

                  <div class="media-frame-soft min-h-[280px] rounded-none border-x-0 border-y-0 shadow-none">
                    <img
                      src={family.image}
                      alt={family.title}
                      class="media-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-[#f4f8fc] py-16 sm:py-20">
      <div class="shell">
        <div class="rounded-[34px] border border-slate-200 bg-white px-8 py-10 shadow-[0_22px_60px_rgba(15,23,42,0.06)] sm:px-10 sm:py-12">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-3xl">
              <span class="section-kicker text-slate-700">Advisory</span>
              <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">
                Need help finding the right product line?
              </h2>
              <p class="mt-4 text-base leading-8 text-slate-600">
                Our team can guide you based on operation type, process, and equipment needs.
              </p>
            </div>
            <a href="/en/contact" class="btn-primary">Talk to an advisor</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterEn />
</Layout>
