---
import Layout from '../../layouts/Layout.astro';
import HeaderEn from '../../components/en/HeaderEn.astro';
import FooterEn from '../../components/en/FooterEn.astro';

const services = [
  {
    title: '1. Specialized Training',
    text: 'Our experts train your team on the proper use of equipment to maximize performance. Proper usage increases productivity and strengthens workplace safety.',
    image: '/images/capacitacion-1.webp'
  },
  {
    title: '2. Efficient Cleaning',
    text: 'We train your staff in best practices for cleaning and maintenance. Proper care extends equipment lifespan and supports peak performance.',
    image: '/images/capacitacion-2.webp'
  },
  {
    title: '3. Efficient Workspace Design',
    text: 'When needed, we create custom layouts for your business. These designs optimize workflow and operational efficiency.',
    image: '/images/capacitacion-3.webp'
  },
  {
    title: '4. Homologated Processes',
    text: 'We ensure your processes meet high quality and safety standards to improve reliability and help you align with industry requirements.',
    image: '/images/capacitacion-4.webp'
  },
  {
    title: '5. Personnel Safety',
    text: 'Safety comes first. We assess and improve working conditions to create a safer environment for your team.',
    image: '/images/capacitacion-5.webp'
  },
  {
    title: '6. Opportunity Identification',
    text: 'We perform detailed analysis to identify opportunities in your operation so you can make better decisions for growth and efficiency.',
    image: '/images/capacitacion-6.webp'
  }
];
---

<Layout
  title="Automotive training in CDMX | Etapel Official Site"
  description="Automotive training in CDMX by Etapel Official Site: homologated processes, technical skills, safety standards, and workshop efficiency."
  lang="en"
  ogLocale="en_US"
>
  <HeaderEn />

  <main class="bg-white">
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#eef5fb_100%)] pb-18 pt-32 sm:pb-22 sm:pt-36">
      <div class="shell">
        <div class="grid items-center gap-10 lg:grid-cols-[1.02fr_0.98fr]">
          <div>
            <span class="section-kicker text-slate-700">Learning system</span>
            <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
              Etapel Training Services
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
              We strengthen proper equipment use, operational efficiency, and team safety through results-driven training.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="https://wa.link/oowyzu" class="btn-primary" target="_blank" rel="noreferrer">Contact us on WhatsApp</a>
              <a href="/en/contact" class="btn-outline">Go to contact</a>
            </div>
          </div>

          <div class="media-frame">
            <img
              src="/images/capacitacion-1.webp"
              alt="Etapel training"
              class="media-cover h-[320px] object-[center_35%] sm:h-[420px] lg:h-[520px]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="grid gap-6 lg:grid-cols-2">
          {
            services.map((service) => (
              <article class="surface-card overflow-hidden">
                <div class="grid gap-0 sm:grid-cols-[0.85fr_1.15fr]">
                  <div class="media-frame-soft min-h-[240px] rounded-none border-y-0 border-l-0 shadow-none">
                    <img
                      src={service.image}
                      alt={service.title}
                      class="media-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-7 sm:p-8">
                    <h2 class="text-2xl font-bold tracking-[-0.03em] text-slate-950">{service.title}</h2>
                    <p class="mt-4 text-base leading-8 text-slate-600">{service.text}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-[#f4f8fc] py-18 sm:py-22">
      <div class="shell">
        <div class="surface-card px-8 py-10 sm:px-10 sm:py-12">
          <div class="max-w-4xl">
            <h2 class="text-3xl font-bold tracking-[-0.04em] text-slate-950 sm:text-4xl">
              Our goal is to be your strategic partner on the path to business success.
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-600">
              Contact us today to discover how Etapel can deliver exceptional value to your company.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="https://wa.link/oowyzu" class="btn-primary" target="_blank" rel="noreferrer">Contact us on WhatsApp</a>
            <a href="/en/contact" class="btn-outline">Contact form</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterEn />
</Layout>
