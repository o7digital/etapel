---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import FeaturedBlocks from '../components/FeaturedBlocks.astro';
import CertificationSection from '../components/CertificationSection.astro';
import ProductHighlight from '../components/ProductHighlight.astro';
import ProductCategories from '../components/ProductCategories.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Taller automotriz, pintura y equipamiento en CDMX | Etapel Sitio Oficial"
  description="Etapel Sitio Oficial: soluciones para taller automotriz en CDMX, pintura, cabinas, soldadura, aire comprimido, capacitación y postventa especializada."
>
  <Header />

  <main>
    <h1 class="sr-only">Taller automotriz, pintura y equipamiento en CDMX | Etapel Sitio Oficial</h1>
    <HeroSlider />
    <FeaturedBlocks />
    <CertificationSection />
    <ProductHighlight />
    <ProductCategories />
    <CTASection />
  </main>

  <Footer />
</Layout>
