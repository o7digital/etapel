---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { productFamilies } from '../../data/productLines';
---

<Layout
  title="Línea de Producto | Etapel"
  description="Hub principal de líneas de producto de Etapel con una navegación clara por familias."
>
  <Header />

  <main class="bg-white">
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#eef5fb_100%)] pb-16 pt-32 sm:pb-20 sm:pt-36">
      <div class="shell">
        <div class="max-w-4xl">
          <span class="section-kicker text-slate-700">Línea de Producto</span>
          <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
            Una navegación clara para toda la oferta de Etapel
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
            Explora las principales familias de producto y accede a cada categoría desde una estructura más profesional, clara y ordenada.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            productFamilies.map((family) => (
              <article class="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-[0_18px_50px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1">
                <div class="h-[240px] overflow-hidden bg-slate-100">
                  <img src={family.image} alt={family.title} class="h-full w-full object-cover transition duration-700 hover:scale-105" loading="lazy" />
                </div>
                <div class="p-7">
                  <h2 class="text-2xl font-bold tracking-[-0.03em] text-slate-950">{family.title}</h2>
                  <p class="mt-4 text-sm leading-7 text-slate-600">{family.menuDescription}</p>
                  <ul class="mt-5 space-y-2 text-sm text-slate-500">
                    {family.items.map((item) => <li>{item}</li>)}
                  </ul>
                  <div class="mt-7">
                    <a href={family.href} class="btn-outline">Ver categoría</a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
