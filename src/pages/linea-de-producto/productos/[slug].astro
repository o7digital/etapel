---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { catalogProducts, productDetailPath, type CatalogProduct } from '../../../data/products';
import { productFamilies } from '../../../data/productLines';

export function getStaticPaths() {
  return catalogProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props as { product: CatalogProduct };
const family = productFamilies.find((item) => item.slug === product.familySlug);
const relatedProducts = catalogProducts
  .filter((item) => item.familySlug === product.familySlug && item.slug !== product.slug)
  .slice(0, 3);
---

<Layout
  title={`${product.name} | Catálogo Etapel`}
  description={product.summary}
>
  <Header />

  <main class="bg-white">
    <section class="bg-[linear-gradient(180deg,#f8fbff_0%,#eef5fb_100%)] pb-14 pt-32 sm:pb-16 sm:pt-36">
      <div class="shell">
        <div class="mb-8 flex flex-wrap items-center gap-3 text-sm font-semibold">
          <a href="/linea-de-producto" class="text-sky-700 transition hover:text-sky-900">Línea de Producto</a>
          <span class="text-slate-400">/</span>
          {family && <a href={family.href} class="text-sky-700 transition hover:text-sky-900">{family.shortTitle}</a>}
          <span class="text-slate-400">/</span>
          <span class="text-slate-600">{product.name}</span>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
          <div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full bg-sky-700 px-3 py-1 text-xs font-bold uppercase tracking-[0.2em] text-white">{product.brand}</span>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-[0_8px_20px_rgba(15,23,42,0.06)]">{product.category}</span>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-[0_8px_20px_rgba(15,23,42,0.06)]">{product.technology}</span>
            </div>
            <h1 class="mt-5 text-4xl font-bold tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-6xl">
              {product.name}
            </h1>
            <p class="mt-5 max-w-3xl text-xl font-semibold leading-8 tracking-[-0.03em] text-slate-800">
              {product.summary}
            </p>
            <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
              {product.description}
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/contacto" class="btn-primary">Solicitar información</a>
              {family && <a href={`${family.href}#catalogo-productos`} class="btn-outline">Volver al catálogo</a>}
            </div>
          </div>

          <div class="overflow-hidden rounded-[8px] border border-slate-200 bg-white shadow-[0_24px_70px_rgba(15,23,42,0.08)]">
            <div class="flex aspect-[4/3] items-center justify-center bg-slate-50 p-8">
              <img src={product.image} alt={product.name} class="h-full w-full object-contain" />
            </div>
            <div class="grid grid-cols-2 gap-3 border-t border-slate-200 p-4">
              {product.gallery.map((image) => (
                <div class="flex aspect-[4/3] items-center justify-center rounded-[8px] bg-slate-50 p-4">
                  <img src={image} alt={product.name} class="h-full w-full object-contain" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="shell">
        <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
          <article class="rounded-[8px] border border-slate-200 bg-white p-6 shadow-[0_16px_44px_rgba(15,23,42,0.05)]">
            <span class="section-kicker text-slate-700">Características</span>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950">Puntos clave</h2>
            <ul class="mt-6 grid gap-4">
              {product.highlights.map((highlight) => (
                <li class="rounded-[8px] border border-slate-200 bg-slate-50 p-4 text-sm font-semibold leading-7 text-slate-700">
                  {highlight}
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-[8px] border border-slate-200 bg-white p-6 shadow-[0_16px_44px_rgba(15,23,42,0.05)]">
            <span class="section-kicker text-slate-700">Datos técnicos</span>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950">Información del producto</h2>
            <dl class="mt-6 grid gap-3 sm:grid-cols-2">
              {product.specs.map((spec) => (
                <div class="rounded-[8px] border border-slate-200 bg-slate-50 p-4">
                  <dt class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">{spec.label}</dt>
                  <dd class="mt-2 text-sm font-semibold leading-6 text-slate-900">{spec.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <article class="rounded-[8px] border border-slate-200 bg-white p-6 shadow-[0_16px_44px_rgba(15,23,42,0.05)]">
            <span class="section-kicker text-slate-700">Variantes</span>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950">Opciones disponibles</h2>
            <div class="mt-6 grid gap-3">
              {product.variants.map((variant) => (
                <div class="rounded-[8px] border border-slate-200 bg-slate-50 p-4">
                  <p class="text-base font-bold text-slate-950">{variant.name}</p>
                  <p class="mt-2 text-sm leading-7 text-slate-600">{variant.note}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="rounded-[8px] border border-slate-200 bg-white p-6 shadow-[0_16px_44px_rgba(15,23,42,0.05)]">
            <span class="section-kicker text-slate-700">Detalle</span>
            <h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] text-slate-950">Uso y asesoría</h2>
            <div class="mt-6 grid gap-5">
              {product.detailBlocks.map((block) => (
                <div>
                  <h3 class="text-lg font-bold tracking-[-0.03em] text-slate-950">{block.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-slate-600">{block.body}</p>
                </div>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    {
      relatedProducts.length > 0 && (
        <section class="bg-[#f6f9fc] py-16 sm:py-20">
          <div class="shell">
            <div class="max-w-3xl">
              <span class="section-kicker text-slate-700">Relacionados</span>
              <h2 class="section-title mt-4 text-slate-950">Más productos de esta línea</h2>
            </div>
            <div class="mt-8 grid gap-4 md:grid-cols-3">
              {relatedProducts.map((item) => (
                <a href={productDetailPath(item)} class="rounded-[8px] border border-slate-200 bg-white p-5 shadow-[0_14px_38px_rgba(15,23,42,0.05)] transition hover:-translate-y-1 hover:border-sky-200">
                  <div class="flex h-40 items-center justify-center bg-slate-50 p-4">
                    <img src={item.image} alt={item.name} class="h-full w-full object-contain" loading="lazy" />
                  </div>
                  <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-sky-700">{item.brand}</p>
                  <h3 class="mt-2 text-lg font-bold tracking-[-0.03em] text-slate-950">{item.name}</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
